{
  "manifest_version": 3,
  "name": "LinkedIn Feed Collector",
  "version": "0.2.0",
  "description": "Scrolls the LinkedIn feed at a human pace and saves posts (text, images, counts) to a local SQLite database.",
  "permissions": [
    "sidePanel",
    "storage",
    "offscreen",
    "unlimitedStorage",
    "notifications"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://media.licdn.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open LinkedIn Feed Collector",
    "default_icon": {
      "48": "icons/icon-48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "content/selectors.js",
        "content/collector.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": {
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
